# Canonical env names — must exactly match process.env.* in src/. Copy to .env.local and fill values (never commit .env.local).
# Verified 2026-09-14 against: lib/auth.ts, lib/gemini.ts, lib/solana.ts, lib/supabase/{client,server}.ts,
# app/api/ai/chat/route.ts, components/auth/PrivyProvider.tsx.
# Removed in this pass (present before, referenced by zero code): NEXT_PUBLIC_SOLANA_NETWORK,
# NEXT_PUBLIC_PROGRAM_ID, SOLANA_PROGRAM_ID, SUPABASE_URL.

# From Privy dashboard > App Settings > App ID (public; used client in PrivyProvider + server JWKS audience in lib/auth.ts)
NEXT_PUBLIC_PRIVY_APP_ID=

# From Supabase dashboard > Project Settings > API > Project URL (public; used by both supabase clients)
NEXT_PUBLIC_SUPABASE_URL=

# From Supabase dashboard > Project Settings > API > anon public key (public; used by both supabase clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From Supabase dashboard > Project Settings > API > service_role secret (server-only; used by createAdminClient in lib/supabase/server.ts — never prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# Solana devnet RPC endpoint, e.g. https://api.devnet.solana.com (public; fallback default lives in lib/solana.ts)
NEXT_PUBLIC_SOLANA_RPC=

# EXB SPL mint address on devnet (public; decimals read live via getMint in lib/solana.ts)
NEXT_PUBLIC_EXB_MINT_ADDRESS=

# From Google AI Studio > API keys (server-only; used by lib/gemini.ts and app/api/ai/chat/route.ts)
GOOGLE_GEMINI_API_KEY=

# Treasury authority secret key: base58 64-byte preferred, base64 64-byte accepted as fallback (server-only; lib/solana.ts decodeAuthoritySecretKey — funds real payouts, keep offline)
SOLANA_PRIVATE_KEY=
